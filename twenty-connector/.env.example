# Copy to .env (gitignored). Generate the key yourself: Twenty -> Settings
# -> API & Webhooks -> "Create API key". Read-only usage is enforced by
# our connector code, not by Twenty itself (Twenty API keys are full-access
# by default) — see CLAUDE.md section 6/13.
TWENTY_API_URL=http://localhost:3000
TWENTY_API_KEY=CHANGE_ME

# Set when creating a webhook in Twenty (Settings -> API & Webhooks ->
# Webhooks -> New). Generate a random one yourself: openssl rand -hex 32
TWENTY_WEBHOOK_SECRET=CHANGE_ME


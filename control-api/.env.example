# Copy to .env (gitignored) and fill in real local values.
# This role/database is dedicated to the Control Plane only — never shared
# with the Observation Plane's database (see CLAUDE.md section 5: no
# cross-plane database access).
DATABASE_URL=postgresql://executive_control_app:CHANGE_ME@localhost:5432/executive_control_dev

# Placeholder for STOP's step-up check (CLAUDE.md section 13). NOT real
# MFA — replaced entirely once OIDC/MFA exists (Week 18). Defaults to
# "dev-step-up-token" if unset, which is fine for local dev only.
STEP_UP_TOKEN=dev-step-up-token
